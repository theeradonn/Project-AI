# Supabase Configuration
# คัดลอกจาก Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Ollama Configuration (optional, defaults shown)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
# ต้อง >= ~6,200 (SYSTEM_PROMPT ~5,400 token + บทสนทนา) ไม่งั้น Ollama ตัด prompt ทิ้งเงียบๆ
OLLAMA_NUM_CTX=8192

# Gemini Configuration (used only by backend/scripts/generate_dataset.py)
# รับ API key ฟรีได้ที่ Google AI Studio — ห้าม hardcode key ในโค้ด
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# (ทางเลือก) ใส่หลาย key คั่นด้วย comma เพื่อหมุนสลับกัน = ยิงได้เร็วขึ้น (แต่ละ key = คนละโควตา)
# ถ้าตั้ง GEMINI_API_KEYS จะใช้ตัวนี้ก่อน ไม่งั้น fallback ไป GEMINI_API_KEY เดี่ยว
# GEMINI_API_KEYS=key1,key2,key3,key4
